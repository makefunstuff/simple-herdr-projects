#!/usr/bin/env python3
"""shp: spaces and tasks for coding agents on Herdr. Plain files, no server."""

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

STORE = Path.home() / ".herdr" / "simple"
CONFIG = {  # config.md defaults
    "coordinator": ["pi"],
    "worker": ["pi"],
    "reviewer": ["pi"],
    "must_fix": "major",
    "rounds": 3,
    "max_running": 4,
}
TASK_ID = re.compile(r"^[A-Za-z]+\d*-\d+$")
HOLDING = ("working", "needs", "ready", "merging")  # statuses whose worker takes a slot


class Refuse(Exception):
    """A command that won't do what was asked, with the reason."""


def tilde(path):
    home = str(Path.home())
    text = str(path)
    return "~" + text[len(home):] if text == home or text.startswith(home + "/") else text


def expand(path):
    return Path(path).expanduser()


def read(path):
    try:
        return path.read_text()
    except OSError as error:
        raise Refuse(f"{tilde(path)}: {error.strerror}")


def write(path, text):
    """One rename: a reader sees the old file or the new one, never half."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".tmp")
    try:
        with os.fdopen(handle, "w") as file:
            file.write(text)
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


@contextmanager
def locked():
    STORE.mkdir(parents=True, exist_ok=True)
    with (STORE / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def scalar(text):
    try:
        return json.loads(text)
    except ValueError:
        return text


def quote(value):
    if (isinstance(value, str) and value and value == value.strip()
            and "\n" not in value and not value.startswith("#") and scalar(value) == value):
        return value
    return json.dumps(value, ensure_ascii=False)


def parse(path):
    lines = read(path).splitlines(keepends=True)
    if not lines or lines[0].rstrip("\r\n") != "---":
        raise Refuse(f"{tilde(path)}: no header (a first line of ---)")
    for end, line in enumerate(lines[1:], 1):
        if line.rstrip("\r\n") == "---":
            break
    else:
        raise Refuse(f"{tilde(path)}: header has no closing ---")
    head = {}
    for number, line in enumerate(lines[1:end], 2):
        key, colon, text = line.partition(":")
        if not colon:
            raise Refuse(f"{tilde(path)}:{number}: expected key: value")
        head[key.strip()] = scalar(text.strip())
    return head, "".join(lines[end + 1:])


def render(head, body):
    lines = ["---\n"]
    lines += [f"{key}: {quote(value)}\n" for key, value in head.items()]
    lines.append("---\n")
    return "".join(lines) + body


def read_brief(name):
    if not name:
        return ""
    text = sys.stdin.read() if name == "-" else read(expand(name))
    return text.strip("\n") + "\n" if text.strip() else ""


def one_space():
    names = [name for name, _, _ in spaces()]
    if len(names) == 1:
        return names[0]
    if not names:
        raise Refuse("there are no spaces yet; shp space add makes one")
    raise Refuse(f"there are {len(names)} spaces; pass --space ({', '.join(names)})")


def space_path(name):
    return STORE / "spaces" / f"{name}.md"


def spaces():
    out = []
    for path in sorted(STORE.glob("spaces/*.md")):
        head, body = parse(path)
        out.append((path.stem, head, body))
    return out


def load_space(name):
    path = space_path(name)
    if not path.is_file():
        raise Refuse(f"there is no space {name}")
    head, body = parse(path)
    for key in ("folder", "prefix", "base"):
        if not head.get(key):
            raise Refuse(f"{tilde(path)} has no {key}")
    return path, head, body


def config():
    path = STORE / "config.md"
    if not path.is_file():
        return dict(CONFIG)
    head, _ = parse(path)
    return {**CONFIG, **head}


def ensure_store():
    if not (STORE / "config.md").exists():
        write(STORE / "config.md", render(CONFIG, ""))


def task_path(space, task_id):
    return STORE / "spaces" / space / f"{task_id}.md"


def read_task(path):
    head, body = parse(path)
    task_id = path.stem
    if head.get("id") and head["id"] != task_id:
        raise Refuse(f"{tilde(path)} says id {head['id']}, not {task_id}")
    head.setdefault("id", task_id)
    head.setdefault("status", "todo")
    head.setdefault("asks", [])
    return head, body


def load_task(task_id):
    if not TASK_ID.match(task_id):
        raise Refuse(f"{task_id} is not a task id")
    hits = [path for path in STORE.glob(f"spaces/*/{task_id}.md") if path.is_file()]
    if not hits:
        raise Refuse(f"there is no task {task_id}")
    if len(hits) > 1:
        raise Refuse(f"{task_id} is in {len(hits)} spaces: {', '.join(p.parent.name for p in hits)}")
    path = hits[0]
    head, body = read_task(path)
    return path.parent.name, path, head, body


def all_tasks():
    tasks, errors = [], []
    for path in sorted(STORE.glob("spaces/*/*.md")):
        if not path.is_file() or not TASK_ID.match(path.stem):
            continue
        try:
            head, body = read_task(path)
        except Refuse as error:
            errors.append(error)
            continue
        tasks.append((path.parent.name, path.stem, path, head, body))
    tasks.sort(key=lambda task: (task[0], int(task[1].rsplit("-", 1)[1])))
    return tasks, errors


def initials(name):
    words = re.findall(r"[A-Za-z0-9]+", name)
    stem = "".join(word[0] for word in words) if len(words) > 1 else (words[0][:4] if words else "")
    stem = re.sub(r"[^A-Za-z]", "", stem).upper()
    return stem.ljust(2, "X")[:5]


def fresh_prefix(name):
    used = {head.get("prefix") for _, head, _ in spaces()}
    base = initials(name)
    prefix, number = base, 2
    while prefix in used:
        prefix = f"{base}{number}"
        number += 1
    return prefix


def slug(title):
    text = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return text[:48].strip("-") or "task"


def next_id(space_name, head):
    prefix = head["prefix"]
    number = int(head.get("next", 1))
    while task_path(space_name, f"{prefix}-{number}").exists():
        number += 1
    return f"{prefix}-{number}", number + 1


def line(task):
    text = f"{task.get('id', '')}  {task.get('status', 'todo')}  {task.get('title', '')}"
    tail = []
    if task.get("progress") is not None or task.get("step"):
        part = []
        if task.get("progress") is not None:
            part.append(f"{task['progress']}%")
        if task.get("step"):
            part.append(str(task["step"]))
        tail.append(" ".join(part))
    asks = task.get("asks") or []
    if asks:
        tail.append("asks: " + " / ".join(f'"{ask.get("text", "")}"' for ask in asks))
    if task.get("left"):
        tail.append(f"{task['left']} left")
    return text + ("  ·  " + "  ·  ".join(tail) if tail else "")


def git(*args):
    done = subprocess.run(["git", *args], capture_output=True, text=True)
    if done.returncode:
        raise Refuse(f"git {args[0]}: {one_line(done.stderr) or 'failed'}")
    return done.stdout


def one_line(text):
    lines = [line for line in text.strip().splitlines() if line.strip()]
    return lines[-1].strip() if lines else ""


def hc(*args):
    done = subprocess.run(["hc", *args], capture_output=True, text=True)
    if done.returncode:
        raise Refuse(f"hc {args[0]}: {one_line(done.stderr or done.stdout) or 'failed'}")
    return done.stdout


def hc_json(*args):
    text = hc(*args)
    try:
        return json.loads(text)
    except ValueError:
        raise Refuse(f"hc {args[0]} printed no JSON")


def app(command, args):
    done = subprocess.run(["herdr-app", "do", command, json.dumps(args)], capture_output=True, text=True)
    try:
        reply = json.loads(done.stdout)
    except ValueError:
        reply = {}
    if done.returncode or reply.get("error"):
        raise Refuse(f"herdr-app {command}: {reply.get('error') or one_line(done.stderr or done.stdout) or 'failed'}")
    return reply


def space_add(args):
    name = args.name
    if not re.fullmatch(r"[a-z][a-z0-9_-]*", name):
        raise Refuse("a space name is lowercase letters, digits, - and _")
    folder = expand(args.folder).resolve()
    found = subprocess.run(["git", "-C", str(folder), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
    if found.returncode:
        raise Refuse(f"{tilde(folder)} is not a git repo")
    top = Path(found.stdout.strip())
    if top != folder:
        raise Refuse(f"{tilde(folder)} is not the repo root; use {tilde(top)}")
    git("-C", folder, "rev-parse", "--verify", f"{args.base}^{{commit}}")
    if args.checks:
        try:
            checks = json.loads(args.checks)
        except ValueError:
            raise Refuse('--checks is JSON like [["make", "check"]]')
        if not isinstance(checks, list) or not all(
                isinstance(c, list) and all(isinstance(x, str) for x in c) for c in checks):
            raise Refuse('--checks is JSON like [["make", "check"]]')
    else:
        checks = []
    brief = read_brief(args.brief)
    with locked():
        ensure_store()
        if space_path(name).exists():
            raise Refuse(f"space {name} already exists")
        prefix = (args.prefix or fresh_prefix(name)).upper()
        if not re.fullmatch(r"[A-Z]{2,5}\d*", prefix):
            raise Refuse("--prefix is 2 to 5 letters, and a digit when another space has it")
        head = {"folder": tilde(folder), "prefix": prefix, "base": args.base,
                "merge": args.merge, "checks": checks, "next": 1}
        write(space_path(name), render(head, brief))
    print(f"space {name}: {prefix}, {tilde(folder)} on {args.base}")


def task_add(args):
    space_name = args.space or one_space()
    title = args.title.strip()
    if not title:
        raise Refuse("a task needs a title")
    agent = json.loads(args.agent) if args.agent else []
    if not isinstance(agent, list) or not all(isinstance(x, str) for x in agent):
        raise Refuse('--agent is JSON like ["claude"]')
    brief = read_brief(args.brief)
    with locked():
        ensure_store()
        path, head, body = load_space(space_name)
        for reference in ([args.parent] if args.parent else []) + (args.after or []):
            load_task(reference)
        try:
            int(head["next"])
        except (KeyError, TypeError, ValueError):
            raise Refuse(f"{tilde(path)} has no usable next")
        task_id, following = next_id(space_name, head)
        repo = expand(head["folder"])
        branch = f"task/{task_id.rsplit('-', 1)[1]}-{slug(title)}"
        worktree = Path("~/.herdr/worktrees").expanduser() / repo.name / branch.replace("/", "-")
        task = {"id": task_id, "title": title, "status": args.status, "agent": agent,
                "branch": branch, "worktree": tilde(worktree), "asks": []}
        if args.parent:
            task["parent"] = args.parent
        if args.after:
            task["after"] = args.after
        write(task_path(space_name, task_id), render(task, "\n" + brief if brief else ""))
        head["next"] = following
        write(path, render(head, body))
    print(task_id)


def list_tasks(args):
    tasks, errors = all_tasks()
    for error in errors:
        print(f"shp: {error}", file=sys.stderr)
    if args.space:
        tasks = [task for task in tasks if task[0] == args.space]
    if args.json:
        print(json.dumps([task[3] for task in tasks], indent=2))
    else:
        for _, _, _, task, _ in tasks:
            print(line(task))
    return 1 if errors else 0


def show_task(args):
    _, path, task, _ = load_task(args.id)
    if args.json:
        print(json.dumps(task, indent=2))
    else:
        sys.stdout.write(read(path))


def print_config(args):
    path = STORE / "config.md"
    sys.stdout.write(read(path) if path.is_file() else render(CONFIG, ""))


def report(args):
    if args.progress is None and args.step is None and args.left is None:
        raise Refuse("nothing to set: use --progress, --step or --left")
    if args.progress is not None and not 0 <= args.progress <= 100:
        raise Refuse("--progress is 0 to 100")
    with locked():
        _, path, task, body = load_task(args.id)
        if args.progress is not None:
            task["progress"] = args.progress
        if args.step is not None:
            task["step"] = args.step
        if args.left is not None:
            task["left"] = args.left
        write(path, render(task, body))
    print(line(task))


def ask(args):
    text = args.text.strip()
    if not text:
        raise Refuse("an ask needs a question")
    with locked():
        _, path, task, body = load_task(args.id)
        if task["status"] not in ("working", "needs"):
            raise Refuse(f"{args.id} is {task['status']}; only a working worker asks")
        entry = {"id": os.urandom(3).hex(), "text": text,
                 "time": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        task["asks"] = (task.get("asks") or []) + [entry]
        task["status"] = "needs"
        write(path, render(task, body))
    print(f"{args.id} needs you: {text}")


def worker_terminal(task_id):
    alive = [terminal for terminal in hc_json("ls").get("terminals", [])
             if terminal.get("state") == "live" and terminal.get("address")
             and terminal.get("labels", {}).get("herdr.role") == "worker"
             and terminal.get("labels", {}).get("herdr.task") == task_id]
    return max(alive, key=lambda terminal: terminal.get("created_ms", 0))["address"] if alive else None


def say(args):
    _, _, task, _ = load_task(args.id)
    asks = task.get("asks") or []
    if args.ask:
        chosen = [ask for ask in asks if ask.get("id") == args.ask]
        if not chosen:
            raise Refuse(f"{args.id} has no ask {args.ask}")
        answer = chosen[0]
    elif len(asks) > 1:
        raise Refuse(f"{args.id} has {len(asks)} asks; pass --ask one of "
                     + ", ".join(str(ask.get("id")) for ask in asks))
    else:
        answer = asks[0] if asks else None
    if task["status"] not in ("working", "needs"):
        raise Refuse(f"{args.id} is {task['status']}; a message goes to a working or waiting worker")
    terminal = worker_terminal(args.id)
    if not terminal:
        raise Refuse(f"{args.id} has no live worker; start it first")
    done = subprocess.run(["hc", "send", terminal, args.text], capture_output=True, text=True)
    if done.returncode:
        raise Refuse(f"the message did not go in: {one_line(done.stderr or done.stdout)}"
                     f"; {args.id} still needs you")
    with locked():
        _, path, task, body = load_task(args.id)
        task["asks"] = [ask for ask in task.get("asks") or []
                        if not answer or ask.get("id") != answer.get("id")]
        if task["status"] == "needs" and not task["asks"]:
            task["status"] = "working"
        write(path, render(task, body))
    print(f"{args.id}: message sent" + (f", ask {answer['id']} closed" if answer else ""))


def worker_prompt(space_name, task, path):
    return (
        f"You are the worker for task {task['id']} in space {space_name}.\n"
        f"Work only in {expand(task['worktree'])} on branch {task['branch']}; do not start other agents.\n"
        f"The task file is {tilde(path)}: its header is the state, the Markdown below is the brief.\n"
        f"Report with: shp status {task['id']} --progress <0-100> --step \"<what you are doing>\" --left <e.g. 20m>\n"
        f"If you need the person, run: shp ask {task['id']} \"<your question>\" and wait for the answer here."
    )


def make_worktree(space, task):
    repo = expand(space["folder"])
    worktree = expand(task["worktree"])
    branch = task["branch"]
    if worktree.exists():
        current = git("-C", worktree, "rev-parse", "--abbrev-ref", "HEAD").strip()
        if current == branch:
            return
        raise Refuse(f"{tilde(worktree)} exists on {current}, not {branch}")
    if subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
                      capture_output=True).returncode == 0:
        raise Refuse(f"branch {branch} already exists")
    worktree.parent.mkdir(parents=True, exist_ok=True)
    git("-C", repo, "worktree", "add", "-b", branch, worktree, space["base"])


def deliver(terminal, text, task_id):
    """A launch task that did not go in: look, then retry; never resend blind."""
    for _ in range(3):
        first = hc_json("get", terminal).get("first_message")
        if not first or first.get("sent"):
            return
        hc("read", terminal)
        hc_json("wait", terminal, "--timeout", "1")
        if hc_json("get", terminal).get("state") != "live":
            break
        sent = subprocess.run(["hc", "send", terminal, text], capture_output=True, text=True)
        if sent.returncode == 0:
            return
    why = f" ({first['reason']})" if first and first.get("reason") else ""
    raise Refuse(f"{task_id}: the worker's first message was not sent{why}")


def start(task_id):
    space_name, path, task, _ = load_task(task_id)
    if task["status"] not in ("todo", "queued"):
        raise Refuse(f"{task_id} is {task['status']}; only todo or queued starts")
    live = worker_terminal(task_id)
    if live:
        raise Refuse(f"{task_id} already has a live worker ({live})")
    _, space, _ = load_space(space_name)
    argv = task.get("agent") or config()["worker"]
    if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
        raise Refuse(f"{task_id} has no worker command; set agent or config worker")
    make_worktree(space, task)
    prompt = worker_prompt(space_name, task, path)
    reply = app("space.new", {
        "name": f"{task_id} · {task['title']}",
        "folder": str(expand(task["worktree"])),
        "tab": "Chat",
        "argv": argv,
        "task": prompt,
    })
    terminal, workspace = reply.get("terminal"), reply.get("space")
    if not terminal:
        raise Refuse(f"herdr-app made no terminal for {task_id}")
    try:
        hc("label", terminal, f"herdr.task={task_id}", "herdr.role=worker")
        deliver(terminal, prompt, task_id)
    except Refuse:
        try:
            if workspace:
                app("space.close", {"id": workspace, "confirmed": True})
        except Refuse:
            pass
        raise
    with locked():
        _, path, task, body = load_task(task_id)
        task["status"] = "working"
        task["workspace"] = workspace
        write(path, render(task, body))
    return task


def start_cmd(args):
    print(line(start(args.id)))


def gates_clear(task, by_id):
    waiting = ([task["parent"]] if task.get("parent") else []) + list(task.get("after") or [])
    return all((by_id.get(reference) or {}).get("status") == "done" for reference in waiting)


def tick(args):
    tasks, errors = all_tasks()
    for error in errors:
        print(f"shp: {error}", file=sys.stderr)
    slots = int(config()["max_running"]) - sum(1 for task in tasks if task[3].get("status") in HOLDING)
    by_id = {task[1]: task[3] for task in tasks}
    started = []
    for _, task_id, _, task, _ in tasks:
        if slots <= 0:
            break
        if task.get("status") != "queued" or not gates_clear(task, by_id):
            continue
        try:
            start(task_id)
            started.append(task_id)
            slots -= 1
        except Refuse as error:
            print(f"shp: {error}", file=sys.stderr)
            errors.append(error)
    for task_id in started:
        print(task_id)
    return 1 if errors else 0


def build_parser():
    parser = argparse.ArgumentParser(prog="shp", description="Spaces and tasks for coding agents on Herdr.")
    commands = parser.add_subparsers(dest="command", required=True)

    config_cmd = commands.add_parser("config", help="print the config file")
    config_cmd.set_defaults(run=print_config)

    space = commands.add_parser("space", help="spaces are git repos")
    space_cmds = space.add_subparsers(dest="space_command", required=True)
    add_space = space_cmds.add_parser("add", help="add a space")
    add_space.add_argument("name")
    add_space.add_argument("--folder", required=True)
    add_space.add_argument("--base", default="main")
    add_space.add_argument("--merge", choices=["local", "pr"], default="local")
    add_space.add_argument("--checks", help='JSON argv lists, e.g. [["make", "check"]]')
    add_space.add_argument("--prefix", help="2-5 letters; derived from the name when left out")
    add_space.add_argument("--brief", help="its brief file, - for stdin")
    add_space.set_defaults(run=space_add)

    add = commands.add_parser("add", help="add a task")
    add.add_argument("title")
    add.add_argument("--space")
    add.add_argument("--brief", help="its brief file, - for stdin")
    add.add_argument("--status", choices=["todo", "queued"], default="todo")
    add.add_argument("--parent")
    add.add_argument("--after", action="append")
    add.add_argument("--agent", help='argv JSON, e.g. ["claude"]; empty runs the config worker')
    add.set_defaults(run=task_add)

    listing = commands.add_parser("list", help="one line per task")
    listing.add_argument("--json", action="store_true", help="the header's keys")
    listing.add_argument("--space")
    listing.set_defaults(run=list_tasks)

    show = commands.add_parser("show", help="print a task")
    show.add_argument("id")
    show.add_argument("--json", action="store_true", help="the header's keys")
    show.set_defaults(run=show_task)

    start = commands.add_parser("start", help="make the worktree and start the worker")
    start.add_argument("id")
    start.set_defaults(run=start_cmd)

    tick_cmd = commands.add_parser("tick", help="start queued tasks that may run")
    tick_cmd.set_defaults(run=tick)

    status = commands.add_parser("status", help="a worker reports its progress")
    status.add_argument("id")
    status.add_argument("--progress", type=int)
    status.add_argument("--step")
    status.add_argument("--left")
    status.set_defaults(run=report)

    ask_cmd = commands.add_parser("ask", help="a worker asks the person")
    ask_cmd.add_argument("id")
    ask_cmd.add_argument("text")
    ask_cmd.set_defaults(run=ask)

    say_cmd = commands.add_parser("say", help="send a person's answer to the worker")
    say_cmd.add_argument("id")
    say_cmd.add_argument("text")
    say_cmd.add_argument("--ask", help="the ask to close; needed when several are open")
    say_cmd.set_defaults(run=say)

    return parser


def main():
    args = build_parser().parse_args()
    try:
        return args.run(args) or 0
    except Refuse as error:
        print(f"shp: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
