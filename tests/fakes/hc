#!/usr/bin/env python3
"""A fake hc: logs each call and answers from $FAKE_STATE."""

import json
import os
import sys
from pathlib import Path

state = Path(os.environ["FAKE_STATE"])
with (state / "hc.log").open("a") as log:
    log.write(json.dumps(sys.argv[1:]) + "\n")


def fact(name, default):
    path = state / name
    return json.loads(path.read_text()) if path.exists() else default


command, args = sys.argv[1], sys.argv[2:]
if command == "get":
    print(json.dumps(fact("get.json", {"state": "live", "first_message": {"sent": True}})))
elif command == "read":
    print("screen")
elif command == "wait":
    print(json.dumps({"ended": False, "reason": "timeout", "turn": 0, "children": []}))
elif command == "ls":
    wanted = {}
    for index, arg in enumerate(args):
        if arg == "--label" and index + 1 < len(args):
            key, _, value = args[index + 1].partition("=")
            wanted[key] = value
    terminals = [terminal for terminal in fact("ls.json", {"terminals": []})["terminals"]
                 if all(terminal.get("labels", {}).get(key) == value for key, value in wanted.items())]
    print(json.dumps({"terminals": [{key: terminal[key] for key in ("address", "state", "agent", "cwd", "where")
                                     if key in terminal} for terminal in terminals]}))
elif command == "send" and (state / "send_fails").exists():
    print(json.dumps({"error": {"kind": "blocked", "message": "blocked"}}), file=sys.stderr)
    sys.exit(1)
else:
    print("{}")
